# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# SQLite for local dev/prototype. Swap to a Postgres URL for production, e.g.:
# postgresql+psycopg2://user:password@host:5432/student_agent
DATABASE_URL=sqlite:///./student_agent.db

# --- Claude API (get this from https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
STAFF_TOKEN_EXPIRE_MINUTES=15
STUDENT_TOKEN_EXPIRE_MINUTES=30

# --- WhatsApp Business Cloud API (Meta) ---
# From https://developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-string-you-want-then-use-it-in-meta-webhook-setup
WHATSAPP_APP_SECRET=your-meta-app-secret

# --- Misc ---
ENVIRONMENT=development
